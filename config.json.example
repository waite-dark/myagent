{
  "llm": {
    "api_key": "sk-your-api-key-here",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o"
  },
  "agent": {
    "name": "MyClaw",
    "system_prompt": "你是 MyClaw，一个有用的 AI 助手。你可以使用工具来帮助用户完成任务。请用简洁、准确的方式回答问题。",
    "max_turns": 10
  },
  "log": {
    "dir": "log",
    "level": "INFO",
    "to_console": false
  }
}
